# Abu.Hub API — copy to .env on Render (Environment tab). Never commit real secrets.
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://abu-hub-jhfi.vercel.app
# Payment verification (server-only secrets — safe here, NEVER in frontend)
FLW_SECRET_KEY=
PAYSTACK_SECRET_KEY=
# Events/worker
ORDER_WEBHOOK=
SELF_URL=
# Postgres later (pool max 10); empty = file store
DATABASE_URL=
PGSSL=
# S3 pre-signed uploads later; empty = safe local upload (2MB cap)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
